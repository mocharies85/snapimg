---
import tools from '../data/tools.json';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SnapImg - Free Online Image Converter & Compressor</title>
  <meta name="description" content="Ultra-fast, 100% private browser-based image converter and optimizer. Zero file uploads, infinite privacy." />

  <!-- Adsterra Social Bar -->
  <script is:inline src="https://pl31615457.profitableratecpmnetwork.com/f8/64/9d/f8649d44dbffa22eac5cf7b2d664637a.js"></script>

  <!-- Adsterra Popunder -->
  <script is:inline src="https://pl31615458.profitableratecpmnetwork.com/60/da/7e/60da7e3533d207d912dbad32d498a3e0.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col antialiased">

  <!-- Navbar -->
  <nav class="border-b border-slate-800 bg-slate-950/60 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-black text-xl tracking-tight text-white">
        <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">⚡</span>
        Snap<span class="text-blue-500">Img</span>
      </a>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          100% Client-Side Privacy
        </span>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="max-w-4xl mx-auto text-center pt-16 pb-12 px-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-6">
      Free Browser-Based Utilities • No Sign Up Required
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
      Transform & Optimize Images <br class="hidden sm:block" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">At Instant Speed</span>
    </h1>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mt-4">
      Convert formats and compress image sizes directly on your device. Your files never touch our servers, guaranteeing complete privacy.
    </p>
  </header>

  <!-- Tools Grid -->
  <main class="max-w-6xl mx-auto px-6 pb-20 flex-1 w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((t) => (
        <a 
          href={`/${t.slug}`} 
          class="group relative bg-slate-800/50 hover:bg-slate-800 border border-slate-700/60 hover:border-blue-500/80 rounded-2xl p-6 transition-all duration-200 flex flex-col justify-between hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-1"
        >
          <div>
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center font-bold text-lg mb-5 group-hover:scale-110 transition duration-200">
              🖼️
            </div>
            <h2 class="text-lg font-bold text-white group-hover:text-blue-400 transition">
              {t.title}
            </h2>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              {t.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-700/40 flex items-center justify-between text-xs font-semibold text-slate-400 group-hover:text-blue-400">
            <span>Launch Tool</span>
            <span class="text-base group-hover:translate-x-1 transition duration-200">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Trust / Feature Badges -->
    <div class="mt-20 pt-12 border-t border-slate-800 grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
      <div class="bg-slate-800/30 p-5 rounded-xl border border-slate-800">
        <div class="text-2xl mb-2">🔒</div>
        <h3 class="font-bold text-white text-sm">GDPR & Zero-Log Safe</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">Images stay strictly in your browser memory. We have zero access to your files.</p>
      </div>
      <div class="bg-slate-800/30 p-5 rounded-xl border border-slate-800">
        <div class="text-2xl mb-2">⚡</div>
        <h3 class="font-bold text-white text-sm">Instant Execution</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">No upload or download queues. Files are processed locally with the power of your CPU.</p>
      </div>
      <div class="bg-slate-800/30 p-5 rounded-xl border border-slate-800">
        <div class="text-2xl mb-2">💎</div>
        <h3 class="font-bold text-white text-sm">Completely Free</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">No subscription, no limits on daily file conversions, and no hidden watermarks.</p>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-slate-950 py-8 text-center text-xs text-slate-500">
    <div class="flex justify-center gap-6 mb-3">
      <a href="/privacy" class="hover:text-slate-300 transition">Privacy Policy</a>
      <a href="/terms" class="hover:text-slate-300 transition">Terms of Service</a>
      <a href="https://curiolot.com" class="hover:text-slate-300 transition">Curiolot Network</a>
    </div>
    <p>© 2026 SnapImg. Fast, open, and private online tools.</p>
  </footer>

</body>
</html>