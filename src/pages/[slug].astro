---
import tools from '../data/tools.json';
import '../styles/global.css';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tool.title} - Fast, Secure & Free | SnapImg</title>
  <meta name="description" content={tool.desc} />
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col antialiased">

  <!-- Navbar -->
  <nav class="border-b border-slate-800 bg-slate-950/60 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-black text-xl tracking-tight text-white">
        <span class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">⚡</span>
        Snap<span class="text-blue-500">Img</span>
      </a>
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-white transition flex items-center gap-1.5 py-1.5 px-3 rounded-lg border border-slate-800 hover:border-slate-700 bg-slate-800/40">
        ← Back to All Tools
      </a>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-3xl mx-auto px-6 pt-12 pb-24 flex-1 w-full flex flex-col items-center">
    
    <!-- Title & Privacy Badge -->
    <header class="text-center mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Client-Side Sandbox: Zero server uploads
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">{tool.title}</h1>
      <p class="text-slate-400 text-sm mt-2 max-w-lg mx-auto leading-relaxed">{tool.desc}</p>
    </header>

    <!-- Interactive Tool Card -->
    <div class="w-full bg-slate-800/60 border border-slate-700/70 backdrop-blur rounded-2xl p-6 sm:p-8 shadow-2xl">
      
      <!-- Drag & Drop Zone -->
      <div 
        id="dropZone"
        class="border-2 border-dashed border-slate-700 hover:border-blue-500/80 bg-slate-900/50 hover:bg-blue-500/5 rounded-xl p-8 flex flex-col items-center justify-center cursor-pointer transition text-center group"
      >
        <div class="w-14 h-14 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center text-2xl mb-3 group-hover:scale-110 transition duration-200">
          📁
        </div>
        <p class="text-sm font-semibold text-white">Click to browse or drop your image here</p>
        <p class="text-xs text-slate-500 mt-1">Supports PNG, JPG, JPEG, WEBP, AVIF</p>
        <input type="file" id="fileInput" accept="image/*" class="hidden" />
      </div>

      <!-- Processing & Settings Panel (Hidden until file selected) -->
      <div id="controlPanel" class="hidden mt-6 space-y-6 pt-6 border-t border-slate-700/60">
        
        <!-- File Info & Thumbnail -->
        <div class="flex items-center gap-4 bg-slate-900/60 p-4 rounded-xl border border-slate-700/40">
          <img id="imgPreview" class="w-16 h-16 object-cover rounded-lg border border-slate-700 bg-slate-950" alt="Preview" />
          <div class="flex-1 min-w-0">
            <p id="fileName" class="text-sm font-semibold text-white truncate">image.png</p>
            <p id="sizeStatus" class="text-xs text-slate-400 mt-0.5">Ready to process...</p>
          </div>
          <span id="savingsBadge" class="hidden text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
            -0%
          </span>
        </div>

        <!-- Quality Range Slider -->
        <div class="bg-slate-900/30 p-4 rounded-xl border border-slate-700/40">
          <div class="flex justify-between items-center text-xs font-semibold text-slate-300 mb-2">
            <span>Compression Quality:</span>
            <span id="qualityText" class="text-blue-400 font-mono text-sm font-bold">80%</span>
          </div>
          <input 
            type="range" 
            id="qualityRange" 
            min="0.1" 
            max="1" 
            step="0.05" 
            value="0.8" 
            class="w-full cursor-pointer accent-blue-500 bg-slate-700 rounded-lg h-2"
          />
          <div class="flex justify-between text-[11px] text-slate-500 mt-1.5 font-medium">
            <span>Smaller file</span>
            <span>Balanced</span>
            <span>Best quality</span>
          </div>
        </div>

        <!-- Download Action -->
        <div>
          <a 
            id="downloadBtn" 
            href="#" 
            class="w-full py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-bold text-sm text-center flex items-center justify-center gap-2 transition duration-150 shadow-lg shadow-blue-600/20"
          >
            <span>⬇ Download File</span>
            <span id="btnSize" class="text-blue-200 text-xs font-normal"></span>
          </a>
        </div>
      </div>

    </div>

    <!-- SEO & How-To Content Block (Improves Google US/EU Search Ranking) -->
    <section class="mt-16 w-full grid grid-cols-1 md:grid-cols-3 gap-6 text-slate-300">
      <div class="bg-slate-800/30 border border-slate-800 p-5 rounded-xl">
        <span class="text-blue-400 font-black text-sm">STEP 1</span>
        <h3 class="font-bold text-white text-sm mt-1">Upload Photo</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">Select or drop any image file straight into the converter sandbox above.</p>
      </div>
      <div class="bg-slate-800/30 border border-slate-800 p-5 rounded-xl">
        <span class="text-blue-400 font-black text-sm">STEP 2</span>
        <h3 class="font-bold text-white text-sm mt-1">Tune Quality</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">Adjust the compression slider to reach your optimal balance between size and quality.</p>
      </div>
      <div class="bg-slate-800/30 border border-slate-800 p-5 rounded-xl">
        <span class="text-blue-400 font-black text-sm">STEP 3</span>
        <h3 class="font-bold text-white text-sm mt-1">Instant Save</h3>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">Click download to retrieve your optimized file directly from browser memory.</p>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 bg-slate-950 py-8 text-center text-xs text-slate-500">
    <p>© 2026 SnapImg. Fast, open, and private online tools.</p>
  </footer>

  <!-- Canvas Processing Script -->
  <script define:vars={{ targetFormat: tool.targetFormat, targetExt: tool.ext }}>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const controlPanel = document.getElementById('controlPanel');
    const imgPreview = document.getElementById('imgPreview');
    const fileNameEl = document.getElementById('fileName');
    const sizeStatus = document.getElementById('sizeStatus');
    const savingsBadge = document.getElementById('savingsBadge');
    const qualityRange = document.getElementById('qualityRange');
    const qualityText = document.getElementById('qualityText');
    const downloadBtn = document.getElementById('downloadBtn');
    const btnSize = document.getElementById('btnSize');

    let currentImg = null;
    let baseFileName = 'image';
    let originalBytes = 0;

    // Trigger file chooser on dropZone click
    dropZone.addEventListener('click', () => fileInput.click());

    // Drag and Drop styling
    ['dragenter', 'dragover'].forEach(name => {
      dropZone.addEventListener(name, (e) => {
        e.preventDefault();
        dropZone.classList.add('border-blue-500', 'bg-blue-500/10');
      });
    });

    ['dragleave', 'drop'].forEach(name => {
      dropZone.addEventListener(name, (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-blue-500', 'bg-blue-500/10');
      });
    });

    dropZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        loadFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        loadFile(e.target.files[0]);
      }
    });

    function loadFile(file) {
      originalBytes = file.size;
      baseFileName = file.name.substring(0, file.name.lastIndexOf('.')) || 'image';
      fileNameEl.textContent = file.name;

      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          currentImg = img;
          imgPreview.src = event.target.result;
          controlPanel.classList.remove('hidden');
          processImage();
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    qualityRange.addEventListener('input', (e) => {
      qualityText.textContent = `${Math.round(e.target.value * 100)}%`;
      if (currentImg) processImage();
    });

    function processImage() {
      const canvas = document.createElement('canvas');
      canvas.width = currentImg.width;
      canvas.height = currentImg.height;

      const ctx = canvas.getContext('2d');
      ctx.drawImage(currentImg, 0, 0);

      const quality = parseFloat(qualityRange.value);

      canvas.toBlob((blob) => {
        if (!blob) return;

        const origKb = (originalBytes / 1024).toFixed(1);
        const newKb = (blob.size / 1024).toFixed(1);
        const savedPercent = Math.round(((originalBytes - blob.size) / originalBytes) * 100);

        sizeStatus.textContent = `${origKb} KB ➔ ${newKb} KB`;

        if (savedPercent > 0) {
          savingsBadge.textContent = `-${savedPercent}% Saved`;
          savingsBadge.classList.remove('hidden');
        } else {
          savingsBadge.classList.add('hidden');
        }

        const downloadUrl = URL.createObjectURL(blob);
        downloadBtn.href = downloadUrl;
        downloadBtn.download = `${baseFileName}-optimized.${targetExt}`;
        btnSize.textContent = `(${newKb} KB)`;
      }, targetFormat, quality);
    }
  </script>

</body>
</html>